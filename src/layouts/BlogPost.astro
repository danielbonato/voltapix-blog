---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import CtaVoltaPix from '../components/CtaVoltaPix.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="pt-BR">
	<head>
		<BaseHead title={title} description={description} image={heroImage} article={true} />
		<style>
			main {
				width: 100%;
				max-width: 860px;
				margin: 0 auto;
				padding: 2.5rem 1.25rem;
				box-sizing: border-box;
			}
			.hero-image {
				width: 100%;
				max-width: 100%;
				margin-bottom: 2rem;
				overflow: hidden;
				border-radius: 16px;
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				max-height: 480px;
				object-fit: cover;
				border-radius: 16px;
				box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
			}
			.prose {
				width: 100%;
				max-width: 760px;
				margin: 0 auto;
				padding: 0;
				box-sizing: border-box;
				color: #334155;
			}
			.title {
				margin-bottom: 2rem;
				padding: 0;
				text-align: left;
			}
			.title h1 {
				font-family: 'Manrope', sans-serif;
				font-size: 2.25rem;
				font-weight: 800;
				line-height: 1.25;
				color: #0b0f19;
				margin: 0 0 1rem 0;
				letter-spacing: -0.02em;
				word-break: normal;
				overflow-wrap: break-word;
			}
			.date {
				margin-bottom: 0.75rem;
				font-size: 0.9rem;
				font-weight: 600;
				color: #004AEA;
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}
			.last-updated-on {
				font-style: italic;
				font-size: 0.85rem;
				color: #64748b;
			}

			@media (max-width: 768px) {
				main {
					width: 100%;
					max-width: 100%;
					padding: 1.25rem 1rem;
					box-sizing: border-box;
				}
				.hero-image {
					margin-bottom: 1.25rem;
					border-radius: 12px;
				}
				.hero-image img {
					border-radius: 12px;
					max-height: 260px;
				}
				.title {
					margin-bottom: 1.25rem;
				}
				.title h1 {
					font-size: 1.45rem;
					line-height: 1.3;
					margin-bottom: 0.5rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt={title} />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										(Atualizado em <FormattedDate date={updatedDate} />)
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<CtaVoltaPix />
		<Footer />
	</body>
</html>
