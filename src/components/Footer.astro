---
const today = new Date();
---

<footer class="voltapix-footer">
	<div class="voltapix-footer-container">
		<img src="/voltapix-logo-branca.svg" alt="VoltaPix" class="voltapix-footer-logo"/>
		<p class="voltapix-footer-text">
			VoltaPix é uma marca operada por DANIEL BONATO QUINTANILHA (Nemex) - CNPJ 65.646.800/0001-20.
		</p>
		<div class="voltapix-footer-links">
			<a class="voltapix-footer-link" href="https://voltapix.com.br/terms?origem=blog_footer" target="_blank" rel="noopener noreferrer">Termos de Uso</a>
			<a class="voltapix-footer-link" href="https://voltapix.com.br/privacy?origem=blog_footer" target="_blank" rel="noopener noreferrer">Política de Privacidade</a>
		</div>
		<a target="_blank" rel="noopener noreferrer" class="voltapix-footer-credit" href="http://www.nemex.com.br">
			Desenvolvido por Nemex.
		</a>
	</div>
</footer>

<style>
	.voltapix-footer {
		background-color: #111827; /* bg-gray-900 */
		padding-top: 1.5rem; /* py-6 */
		padding-bottom: 1.5rem;
		margin-top: auto; /* mt-auto */
		border-top: 1px solid rgba(255, 255, 255, 0.1); /* border-t border-white/10 */
		width: 100%;
	}
	.voltapix-footer-container {
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem; /* gap-4 */
		text-align: center;
		width: 100%;
		max-width: 80rem; /* container mx-auto */
		padding-left: 1rem;
		padding-right: 1rem;
	}
	.voltapix-footer-logo {
		height: 1.5rem; /* h-6 */
		width: auto;
		opacity: 0.9;
	}
	.voltapix-footer-text {
		font-size: 0.75rem; /* text-xs */
		color: #64748b; /* text-slate-500 */
		max-width: 42rem; /* max-w-2xl */
		margin: 0;
	}
	.voltapix-footer-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 1rem; /* gap-4 */
		font-size: 0.875rem; /* text-sm */
		color: #94a3b8; /* text-slate-400 */
	}
	.voltapix-footer-link {
		color: #94a3b8;
		text-decoration: none;
		transition: color 0.2s;
	}
	.voltapix-footer-link:hover {
		color: #ffffff; /* hover:text-white */
	}
	.voltapix-footer-credit {
		font-size: 0.75rem; /* text-xs */
		font-weight: 600; /* font-semibold */
		letter-spacing: 0.05em; /* tracking-wider */
		color: #60a5fa; /* text-blue-400 */
		text-decoration: none;
		transition: color 0.2s;
	}
	.voltapix-footer-credit:hover {
		color: #93c5fd; /* hover:text-blue-300 */
	}
</style>
