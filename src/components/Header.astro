---
import { SITE_TITLE } from '../consts';
---
<header class="voltapix-header">
	<div class="voltapix-header-container">
		<a class="voltapix-logo-link" href="/">
			<img src="/voltapix-logo-quad.svg" alt="VoltaPix" class="voltapix-logo-icon" />
			<span class="voltapix-brand-name">VoltaPix</span>
		</a>
		<div class="voltapix-actions">
			<a class="voltapix-signup-btn" href="https://voltapix.com.br?origem=blog_header" target="_blank" rel="noopener noreferrer">
				Visite o site
			</a>
		</div>
	</div>
</header>

<style>
	.voltapix-header {
		background-color: #0b0f19;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		width: 100%;
	}
	.voltapix-header-container {
		margin: 0 auto;
		display: flex;
		height: 4rem;
		max-width: 80rem;
		align-items: center;
		justify-content: space-between;
		padding-left: 1rem;
		padding-right: 1rem;
	}
	@media (min-width: 640px) {
		.voltapix-header-container { padding-left: 1.5rem; padding-right: 1.5rem; }
	}
	@media (min-width: 1024px) {
		.voltapix-header-container { padding-left: 2rem; padding-right: 2rem; }
	}
	.voltapix-logo-link {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		text-decoration: none;
	}
	.voltapix-logo-icon {
		height: 2rem;
		width: auto;
	}
	.voltapix-brand-name {
		font-family: 'Manrope', sans-serif;
		font-size: 1.25rem;
		font-weight: 800;
		color: #ffffff;
		letter-spacing: -0.02em;
	}
	.voltapix-actions {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.voltapix-signup-btn {
		white-space: nowrap;
		border-radius: 0.5rem;
		background-color: #004AEA;
		padding: 0.5rem 1rem;
		font-size: 0.875rem;
		font-weight: 600;
		color: #ffffff;
		text-decoration: none;
		box-shadow: 0 8px 16px -3px rgba(0, 74, 234, 0.35);
		transition: all 0.2s;
	}
	.voltapix-signup-btn:hover {
		background-color: #0038C4;
		box-shadow: 0 10px 20px -3px rgba(0, 74, 234, 0.5);
		transform: translateY(-1px);
	}
</style>
